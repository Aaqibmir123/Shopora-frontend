{
  "expo": {
    "name": "NovaMart",
    "slug": "shopora-marketplace",
    "scheme": "shopora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "platforms": ["ios", "android"],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {}
  }
}

